{
  "name": "@perfectwebtech/chatbot-widget",
  "version": "2.0.0-alpha.1",
  "description": "Embeddable, framework-free chat widget for Rasa bots. Ships as a single script tag, renders inside a Shadow DOM, speaks REST, SSE streaming and Socket.IO.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/chatbot-widget.es.js",
  "module": "./dist/chatbot-widget.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/chatbot-widget.es.js",
      "default": "./dist/chatbot-widget.iife.js"
    },
    "./iife": "./dist/chatbot-widget.iife.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && vite build --mode iife",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "dompurify": "^3.2.0",
    "marked": "^15.0.0",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^15.0.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
